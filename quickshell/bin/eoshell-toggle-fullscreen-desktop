#!/bin/bash

# eoshell:summary=Toggle a full screen desktop: hide the top bar and remove the window gaps together
# eoshell:args=[toggle|on|off]
# eoshell:examples=eoshell toggle fullscreen desktop | eoshell toggle fullscreen desktop off | eoshell toggle fullscreen desktop on

ACTION="${1:-toggle}"

case $ACTION in
  toggle|"")
    # Only leave full screen when both halves are already in it, so a lone bar
    # or a lone gap toggle is pulled into line rather than flipped away.
    if eoshell-toggle-enabled bar-off && eoshell-hyprland-toggle-enabled window-no-gaps; then
      ACTION="off"
    else
      ACTION="on"
    fi
    ;;
  on|off) ;;
  *)
    echo "Usage: eoshell-toggle-fullscreen-desktop [toggle|on|off]" >&2
    exit 1
    ;;
esac

eoshell-toggle-bar "$ACTION"
eoshell-hyprland-toggle window-no-gaps "$ACTION"
