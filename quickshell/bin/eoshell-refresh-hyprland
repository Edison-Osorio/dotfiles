#!/bin/bash

# eoshell:summary=Overwrite all the user Hyprland Lua configs in ~/.config/hypr with the Eoshell defaults.

eoshell-refresh-config hypr/.luarc.json
eoshell-refresh-config hypr/autostart.lua
eoshell-refresh-config hypr/bindings.lua
eoshell-refresh-config hypr/input.lua
eoshell-refresh-config hypr/looknfeel.lua
eoshell-refresh-config hypr/hyprland.lua
eoshell-refresh-config hypr/monitors.lua

mkdir -p ~/.local/state/eoshell/toggles/hypr
cp "$EOSHELL_PATH/default/hypr/toggles/flags.lua" ~/.local/state/eoshell/toggles/hypr/
