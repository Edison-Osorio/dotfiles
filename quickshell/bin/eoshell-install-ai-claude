#!/bin/bash

# eoshell:summary=Install the Claude desktop app
# eoshell:requires-sudo=true

set -euo pipefail

echo "Installing Claude..."
eoshell-pkg-add claude-desktop

echo "Opening Claude..."
setsid uwsm-app -- /usr/bin/claude-desktop >/dev/null 2>&1 &

echo ""
echo "Claude has been installed."
