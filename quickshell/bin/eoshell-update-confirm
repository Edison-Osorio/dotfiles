#!/bin/bash

# eoshell:summary=Prompt for confirmation before starting an update

gum style --border normal --padding "1 2" \
  "$(eoshell-i18n update.ready)" \
  "" \
  "• $(eoshell-i18n update.cannotStop)" \
  "• $(eoshell-i18n update.connectPower)" \
  "" \
  "$(eoshell-i18n update.whatsNew "https://github.com/omacom/eoshell/releases/latest")"

echo

if ! gum confirm --affirmative "$(eoshell-i18n common.yes)" --negative "$(eoshell-i18n common.no)" "$(eoshell-i18n update.continue)"; then
  echo "Update cancelled"
  exit 1
fi
