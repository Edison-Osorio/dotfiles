#!/bin/bash

# eoshell:summary=Remove Dropbox and its bar plugin.
# eoshell:requires-sudo=true

dropbox-cli stop 2>/dev/null || true
eoshell-plugin-disable eoshell.dropbox
eoshell-pkg-drop dropbox dropbox-cli python-gpgme nautilus-dropbox

# Other tray apps need libappindicator too, and naming a required package fails the whole removal
if pacman -Qqtt libappindicator &>/dev/null; then
  eoshell-pkg-drop libappindicator
fi

echo ""
echo "Dropbox has been removed."
