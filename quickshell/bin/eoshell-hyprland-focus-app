#!/bin/bash

# eoshell:summary=Focus a Hyprland window by application identity
# eoshell:args=<app-name>
# eoshell:examples=eoshell hyprland focus app Slack

usage() {
  echo "Usage: eoshell-hyprland-focus-app <app-name>" >&2
  exit 1
}

app=${1:-}
[[ -n $app ]] || usage

# Agent terminals notify as kitty/foot/etc. while their shared window class is
# org.eoshell.agent, leaving the terminal name only in initialTitle. So match
# by class first, then fall back to the launch-time title of agent windows.
# Among several matches take the one focused last, which is also the window a
# browser hands a new tab to.
address=$(
  hyprctl clients -j 2>/dev/null |
    jq -r --arg pattern "$app" \
      'def matches($value): ($value // "") | test($pattern; "i");
       sort_by(.focusHistoryID) |
       first(
         (.[] | select(matches(.class))),
         (.[] | select(.initialClass == "org.eoshell.agent" and matches(.initialTitle)))
       ).address // empty'
)

[[ -n $address ]] || exit 1

hyprctl dispatch "hl.dsp.focus({ window = \"address:$address\" })" >/dev/null 2>&1 || \
  hyprctl dispatch focuswindow "address:$address" >/dev/null
