#!/bin/bash

# eoshell:summary=Record dictation using Voxtype
# eoshell:args=<start|stop|toggle>

case "${1:-}" in
  start|toggle) voxtype record "$1" ;;
  stop)
    if eoshell-cmd-missing voxtype || [[ $(voxtype status) == "stopped" ]]; then
      exit 0
    else
      voxtype record stop
    fi
    ;;
  *) echo "Usage: eoshell dictation voxtype <start|stop|toggle>" >&2; exit 1 ;;
esac
