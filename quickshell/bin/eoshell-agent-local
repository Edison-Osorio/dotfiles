#!/bin/bash

# eoshell:summary=Run open models on this machine for your agents
# eoshell:args=<use|list|status|start|stop|remove> [args]
# eoshell:examples=eoshell agent local use best | eoshell agent local use qwen3.8-27b-gufo | eoshell agent local stop | eoshell-agent-local use --help

# The engine and its recipes come in eoshell-local-ai, on every machine so the
# agents panel knows which models fit. Podman, which runs them, only comes when
# a model is first set up, from the terminal that setup runs in. An NVIDIA GPU
# reaches the containers through the CDI spec nvidia-container-toolkit writes
# on install and again at every boot.
if [[ ${1:-} == "use" ]]; then
  packages=(podman crun)
  if eoshell-hw-nvidia; then
    packages+=(nvidia-container-toolkit)
  fi
  eoshell-pkg-add "${packages[@]}" || exit 1
fi

exec eoshell-local-ai "$@"
