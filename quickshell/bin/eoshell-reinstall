#!/bin/bash

# eoshell:summary=Reinstall Eoshell packages and reset default configs
# eoshell:requires-sudo=true

set -e

echo -e "This will reinstall all default Eoshell packages and reset default configs.\nWarning: user config changes will be overwritten.\n"

if gum confirm "Are you sure you want to reinstall and lose config changes?"; then
  eoshell-reinstall-pkgs
  eoshell-reinstall-configs

  gum confirm "System has been reinstalled. Reboot?" && eoshell-system reboot
fi
