#!/bin/bash

# eoshell:summary=Open the current theme's user background folder

CURRENT_THEME_NAME=$(cat "$HOME/.local/state/eoshell/current/theme.name")
THEME_USER_BACKGROUNDS="$HOME/.config/eoshell/backgrounds/$CURRENT_THEME_NAME"

mkdir -p "$THEME_USER_BACKGROUNDS"
nautilus "$THEME_USER_BACKGROUNDS"
