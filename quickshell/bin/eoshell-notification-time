#!/bin/bash

# eoshell:summary=Show the current time and date notification

# Day and month names follow the Eoshell language right away, rather than
# LC_TIME, which only catches up with it at the next login. One timestamp feeds
# every part, so a notification sent at midnight can't mix two days.
locale=$(eoshell-language locale)
now=$(date +%s)
day_time=$(LC_TIME=$locale date -d "@$now" +"%A %H:%M")
day_month_year=$(LC_TIME=$locale date -d "@$now" +"%d %B %Y")

eoshell-notification-send -g  -u low "$(eoshell-i18n time.now "$day_time" "$day_month_year" "$(date -d "@$now" +%V)")"
