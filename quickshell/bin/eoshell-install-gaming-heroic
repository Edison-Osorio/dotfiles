#!/bin/bash

# eoshell:summary=Install Heroic Games Launcher (Epic, GOG, Amazon Prime Gaming) with graphics drivers.
# eoshell:requires-sudo=true

set -e

echo "Installing Heroic Games Launcher..."
eoshell-pkg-add heroic-games-launcher-bin
eoshell-install-gaming-gpu-lib32

setsid uwsm-app -- gtk-launch heroic >/dev/null 2>&1 &
