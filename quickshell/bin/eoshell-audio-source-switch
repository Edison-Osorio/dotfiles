#!/bin/bash

# eoshell:summary=Cycle to the next media source and transfer playback when the current source is playing
# eoshell:args=[next|previous]
# eoshell:examples=eoshell audio source switch | eoshell-audio-source-switch previous

direction="${1:-next}"

case "$direction" in
  next)
    eoshell-shell media sourceSwitch
    ;;
  previous)
    eoshell-shell media sourceSwitchPrevious
    ;;
  *)
    echo "Usage: eoshell-audio-source-switch [next|previous]" >&2
    exit 1
    ;;
esac
