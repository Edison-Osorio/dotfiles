#!/bin/bash

# eoshell:summary=Install and configure Superwhisper dictation
# eoshell:args=[--background]
# eoshell:requires-sudo=true

set -e

# First run configures the preinstalled package unattended, so it must not
# open settings or announce itself.
background=false
if [[ ${1:-} == "--background" ]]; then
  background=true
elif (($# > 0)); then
  echo "Usage: eoshell install dictation superwhisper [--background]" >&2
  exit 1
fi

eoshell-pkg-add superwhisper-bin
bash /usr/share/superwhisper/setup-user
# Existing profiles may still use Right Alt, which conflicts with Eoshell.
# Keep a recording shortcut active while moving away from that binding.
shortcuts=$(superwhisper shortcuts show)
if [[ $(jq -r '.shortcuts.hold' <<< "$shortcuts") == "RightAlt" ]]; then
  if [[ -z $(jq -r '.shortcuts.toggle' <<< "$shortcuts") ]]; then
    superwhisper shortcuts set hold "RightSuper" >/dev/null
  else
    superwhisper shortcuts set hold none >/dev/null
  fi
fi
# Superwhisper requires a native recording shortcut; keep it separate from
# Eoshell's recording keys (Alt + Space and Right Alt).
superwhisper shortcuts set toggle "Ctrl+Alt+Space" >/dev/null
superwhisper shortcuts set hold none >/dev/null
eoshell-dictation-use superwhisper
eoshell-restart-hyprctl
if [[ $background == "false" ]]; then
  eoshell-notification-send -g  "$(eoshell-i18n dictation.superwhisperReady)" "$(eoshell-i18n dictation.hint)" -t 10000
  superwhisper settings
fi
