#!/bin/bash

# eoshell:summary=Toggle mirroring theme changes to and from your herdr machines

eoshell-toggle herdr-theme-sync

if eoshell-toggle-enabled herdr-theme-sync; then
  eoshell-notification-send -g 󰸌 "$(eoshell-i18n themeSync.enabled)"
else
  eoshell-notification-send -g 󰸌 "$(eoshell-i18n themeSync.disabled)"
fi
