#!/bin/bash

# eoshell:summary=Print when system packages were last upgraded

upgraded=$(grep upgraded /var/log/pacman.log | tail -1 | sed -E 's/\[([^]]+)\].*/\1/')
locale=$(eoshell-language locale)

eoshell-i18n about.updatedAt \
  "$(LC_TIME=$locale date -d "$upgraded" +"%A %d %B %Y")" \
  "$(date -d "$upgraded" +"%H:%M")"
