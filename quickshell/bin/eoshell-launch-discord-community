#!/bin/bash

# eoshell:summary=Open the Eoshell Discord community in the Discord app or a browser.

invite="https://discord.gg/tXFUdasqhY"

if eoshell-cmd-present discord; then
  exec setsid eoshell-app -- discord --url -- "discord://-/invite/${invite##*/}"
else
  exec eoshell-launch-webapp "$invite"
fi
