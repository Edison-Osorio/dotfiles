#!/bin/bash

# eoshell:summary=Sync the generated Eoshell theme to running Slack windows
# eoshell:hidden=true

set -euo pipefail

state="$HOME/.local/state/eoshell/slack"
theme="$HOME/.local/state/eoshell/current/theme/slack.json"
[[ -f $state/enabled && -f $theme ]] || exit 0

pending=$(mktemp "$state/theme.XXXXXX")
trap 'rm -f "$pending"' EXIT
if jq -e 'select(.mode == "light" or .mode == "dark") |
  select([.background, .accent, .green, .red] | all(type == "string" and test("^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"))) |
  {mode, background, accent, green, red} |
  with_entries(if .key == "mode" then . else .value |= .[0:7] end)' "$theme" >"$pending"; then
  mv "$pending" "$state/theme.json"
else
  echo "Skipping invalid Slack theme." >&2
fi
