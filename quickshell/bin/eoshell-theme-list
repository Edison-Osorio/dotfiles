#!/bin/bash

# eoshell:summary=List available themes
# eoshell:examples=eoshell theme list | eoshell theme set "Tokyo Night"

{
  find ~/.config/eoshell/themes/ -mindepth 1 -maxdepth 1 \( -type d -o -type l \) -printf '%f\n'
  find "$EOSHELL_PATH/themes/" -mindepth 1 -maxdepth 1 -type d -printf '%f\n'
} | sort -u | sed -E 's/(^|-)([a-z])/\1\u\2/g; s/-/ /g'
