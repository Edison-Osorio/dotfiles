#!/bin/bash

# eoshell:summary=Select and set the system timezone
# eoshell:group=menu
# eoshell:name=timezone

set -e

timezone=$(timedatectl list-timezones | eoshell-menu-select "$(eoshell-i18n timezone.setTitle)" -- --width 520 --maxheight 520) || exit 1
sudo timedatectl set-timezone "$timezone"
eoshell-shell -q eoshell.clock refresh
eoshell-notification-send "$(eoshell-i18n timezone.changed "$timezone")"
