#!/bin/bash

# eoshell:summary=Open a config file in the user's editor and surface a toast
# eoshell:args=<path>
# eoshell:examples=eoshell launch config-editor ~/.config/hypr/hyprland.lua

path="${1-}"

if [[ -z $path ]]; then
  echo "Usage: eoshell-launch-config-editor <path>" >&2
  exit 1
fi

eoshell-notification-send -u low "$(eoshell-i18n config.editing)" "$path"
exec eoshell-launch-editor "$path"
