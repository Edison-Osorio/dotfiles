#!/bin/bash

# eoshell:summary=Remove Tailscale and its bar plugin.
# eoshell:requires-sudo=true

tailscale down 2>/dev/null || true
systemctl --user disable --now eoshell-tailscale-receive.service 2>/dev/null || true
sudo systemctl disable --now tailscaled.service 2>/dev/null || true
eoshell-plugin-disable eoshell.tailscale
eoshell-webapp-remove "Tailscale" 2>/dev/null || true
eoshell-pkg-drop tailscale

echo ""
echo "Tailscale has been removed."
