#!/bin/bash

# eoshell:summary=Install the NordVPN service with optional GUI.
# eoshell:requires-sudo=true

echo "Installing NordVPN..."
eoshell-pkg-add nordvpn-bin

echo "Enabling NordVPN daemon..."
sudo systemctl enable --now nordvpnd

echo "Adding user to nordvpn group..."
sudo usermod -aG nordvpn "$USER"

echo -e "\nNordVPN installed! After reboot, run 'nordvpn login' to authenticate."

echo
gum confirm --affirmative "$(eoshell-i18n common.yes)" --negative "$(eoshell-i18n common.no)" "$(eoshell-i18n nordvpn.rebootNow)" && eoshell-system reboot
