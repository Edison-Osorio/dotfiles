#!/bin/bash

# eoshell:summary=Run a command while holding the Eoshell update lock
# eoshell:args=<held|run> [command] [args...]
# eoshell:hidden=true

set -e

lock_dir="${XDG_RUNTIME_DIR:-/tmp}"
lock_path="$lock_dir/eoshell-update.lock"

lock_is_held() {
  local lock_fd_path=""

  [[ -n ${EOSHELL_UPDATE_LOCK_FD:-} && -e /proc/$$/fd/$EOSHELL_UPDATE_LOCK_FD ]] || return 1

  lock_fd_path=$(readlink -f "/proc/$$/fd/$EOSHELL_UPDATE_LOCK_FD" 2>/dev/null || true)
  [[ $lock_fd_path == "$(readlink -m "$lock_path")" ]] &&
    flock -n "$EOSHELL_UPDATE_LOCK_FD"
}

case "${1:-}" in
  held)
    lock_is_held
    ;;
  run)
    shift
    if (( $# == 0 )); then
      echo "Usage: eoshell-update-lock run <command> [args...]" >&2
      exit 2
    fi

    mkdir -p "$lock_dir" 2>/dev/null || true
    exec {EOSHELL_UPDATE_LOCK_FD}>"$lock_path"
    if ! flock -n "$EOSHELL_UPDATE_LOCK_FD"; then
      echo "An Eoshell update is already running."
      exit 1
    fi

    export EOSHELL_UPDATE_LOCK_FD
    exec "$@"
    ;;
  *)
    echo "Usage: eoshell-update-lock <held|run> [command] [args...]" >&2
    exit 2
    ;;
esac
