#!/bin/bash

# eoshell:summary=Enable or disable background intros
# eoshell:args=<enable|disable|toggle|status>
# eoshell:examples=eoshell theme bg intro toggle | eoshell theme bg intro disable

set -euo pipefail

toggle="$HOME/.local/state/eoshell/toggles/background-intros-off"
case ${1:-} in
  enable)
    rm -f "$toggle"
    eoshell-notification-send "$(eoshell-i18n theme.backgroundIntros)" "$(eoshell-i18n common.enabled)"
    ;;
  disable)
    mkdir -p "$(dirname "$toggle")"
    touch "$toggle"
    eoshell-notification-send "$(eoshell-i18n theme.backgroundIntros)" "$(eoshell-i18n common.disabled)"
    ;;
  toggle)
    if [[ -f $toggle ]]; then
      eoshell-theme-bg-intro enable
    else
      eoshell-theme-bg-intro disable
    fi
    ;;
  status)
    [[ ! -f $toggle ]]
    ;;
  *)
    echo "Usage: eoshell-theme-bg-intro <enable|disable|toggle|status>" >&2
    exit 1
    ;;
esac
