#!/bin/bash

# eoshell:summary=Control the Eoshell menu (toggle / summon / close / refresh)
# eoshell:args=[toggle|summon|close|refresh|ping] [route]
# eoshell:examples=eoshell menu | eoshell menu toggle system | eoshell menu summon appearance.theme | eoshell menu refresh

# Thin wrapper around the standard plugin IPC surface. The menu is the
# first-party `eoshell.menu` plugin; routes are passed as JSON payload.

set -euo pipefail

verb="${1-toggle}"
route="${2-root}"

menu_payload() {
  jq -nc --arg menu "$1" '{ menu: $menu }'
}

case "$verb" in
  toggle)
    exec eoshell-shell shell toggle eoshell.menu "$(menu_payload "$route")"
    ;;
  summon)
    exec eoshell-shell shell summon eoshell.menu "$(menu_payload "$route")"
    ;;
  close)
    exec eoshell-shell shell hide eoshell.menu
    ;;
  refresh | ping)
    exec eoshell-shell shell call eoshell.menu "$verb" "{}"
    ;;
  -h | --help | help)
    cat <<USAGE
Usage: eoshell menu [verb] [route]

Verbs:
  toggle [route]   Open the menu at <route>, or close it if already open. Default verb.
  summon [route]   Always open the menu (no close-if-visible toggle).
  close            Close the menu if it is visible.
  refresh          Re-parse the menu JSONC files.
  ping             Health check.

Route is an item id (e.g. setup.power) or alias (e.g. power). Defaults to
"root", which opens the top-level menu.
USAGE
    exit 0
    ;;
  *)
    echo "eoshell-menu: unknown verb '$verb'. Try 'eoshell menu --help'." >&2
    exit 2
    ;;
esac
