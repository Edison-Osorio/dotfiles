#!/bin/bash

# eoshell:summary=Set the system monospace font
# eoshell:args=<font-name>
# eoshell:examples=eoshell font list | eoshell font set "CaskaydiaMono Nerd Font"

usage() {
  echo "Usage: eoshell-font-set <font-name>"
}

font_name="${1:-}"

case "$font_name" in
  -h|--help)
    usage
    exit 0
    ;;
  "")
    usage >&2
    exit 1
    ;;
esac

if ! fc-list | grep -Fqi -- "$font_name"; then
  echo "Font '$font_name' not found."
  exit 1
fi

if [[ -f ~/.config/alacritty/alacritty.toml ]]; then
  sed -i "s/family = \".*\"/family = \"$font_name\"/g" ~/.config/alacritty/alacritty.toml
fi

if [[ -f ~/.config/kitty/kitty.conf ]] || eoshell-cmd-present kitty; then
  mkdir -p ~/.config/kitty
  if grep -qE '^[[:space:]]*font_family[[:space:]]+' ~/.config/kitty/kitty.conf 2>/dev/null; then
    kitty_font_name=$(printf '%s' "$font_name" | sed 's/[\\&/]/\\&/g')
    sed --follow-symlinks -i -E "s/^[[:space:]]*font_family[[:space:]]+.*/font_family $kitty_font_name/" ~/.config/kitty/kitty.conf
  else
    printf '\nfont_family %s\n' "$font_name" >>~/.config/kitty/kitty.conf
  fi
  pkill -USR1 kitty
fi

if [[ -f ~/.config/ghostty/config ]]; then
  sed -i "s/font-family = \".*\"/font-family = \"$font_name\"/g" ~/.config/ghostty/config
  pkill -SIGUSR2 ghostty
fi

if [[ -f ~/.config/foot/foot.ini ]]; then
  # Preserve the primary font's size, not a fallback's; Eoshell ships 9 when none is present.
  foot_size="$(sed -n 's/^font=[^,]*:size=\([0-9.]\+\).*/\1/p' ~/.config/foot/foot.ini | head -1)"
  if [[ -z $foot_size ]]; then
    foot_size=9
  fi
  sed -i "s/^font=.*/font=$font_name:size=$foot_size/g" ~/.config/foot/foot.ini
fi

# fontconfig is the canonical source of truth — the eoshell shell, Qt apps,
# and anything resolving "monospace" all read from here. This file is loaded
# after the package-owned default, and prepend_first puts the chosen family at
# the head of the list so it wins over the family that default prefers.
fontconfig_file="$HOME/.config/fontconfig/fonts.conf"
mkdir -p "$(dirname "$fontconfig_file")"
cat >"$fontconfig_file" <<XML
<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "fonts.dtd">
<fontconfig>
  <match target="pattern">
    <test name="family" qual="any">
      <string>monospace</string>
    </test>
    <edit name="family" mode="prepend_first" binding="strong">
      <string>$font_name</string>
    </edit>
  </match>
</fontconfig>
XML

eoshell-restart-shell

if pgrep -x ghostty >/dev/null; then
  eoshell-notification-send -g  "$(eoshell-i18n font.restartToSeeChange Ghostty)"
fi

if pgrep -x foot >/dev/null; then
  eoshell-notification-send -g  "$(eoshell-i18n font.restartToSeeChange Foot)"
fi

eoshell-hook font-set "$font_name"
