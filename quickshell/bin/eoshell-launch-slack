#!/bin/bash

# eoshell:summary=Launch Slack with live Eoshell theme support
# eoshell:args=[slack-arguments...]
# eoshell:hidden=true

# Slack's own restarts come back through here with the pipe flag the
# launcher added; the launcher adds it again with a pipe behind it.
arguments=()
for argument in "$@"; do
  [[ $argument == "--remote-debugging-pipe" ]] || arguments+=("$argument")
done

if [[ -f $HOME/.local/state/eoshell/slack/enabled ]]; then
  exec /usr/bin/python "$EOSHELL_PATH/default/slack/launcher.py" "${arguments[@]}"
else
  exec /usr/bin/slack "${arguments[@]}"
fi
