#!/bin/bash

# eoshell:summary=Rename a Claude, Codex, or Grok subscription account
# eoshell:args=[claude|codex|grok] <account> <name>
# eoshell:examples=eoshell agent account rename primary Hey | eoshell agent account rename codex side Side project

set -uo pipefail

# The provider can be left out when it's your default agent:
# `eoshell agent account rename primary Hey`.
if [[ ${1:-} != "claude" && ${1:-} != "codex" && ${1:-} != "grok" ]]; then
  default=$(eoshell-default-agent)
  [[ $default == "claude" || $default == "codex" || $default == "grok" ]] && set -- "$default" "$@"
fi

if [[ ${1:-} != "claude" && ${1:-} != "codex" && ${1:-} != "grok" ]] || (( $# < 3 )); then
  echo "Usage: eoshell-agent-account-rename [claude|codex|grok] <account> <name>" >&2
  exit 1
fi

account=$(eoshell-agent-account-state rename "$@") || exit 1
echo "Renamed to $(jq -r .label <<<"$account"). Switch to it with: eoshell agent account use $1 $(jq -r .id <<<"$account")"
# The panel reads account names from the usage record.
eoshell-agent-usage-update --limits-only "$1" >/dev/null 2>&1 &
