#!/bin/bash

# eoshell:summary=Remove Steam and all of its game libraries, configs, and caches.
# eoshell:requires-sudo=true

set -e

eoshell-lifecycle-dispatch pre-remove steam
eoshell-pkg-drop steam

rm -rf \
  "$HOME/.steam" \
  "$HOME/.local/share/Steam" \
  "$HOME/.config/steam" \
  "$HOME/.cache/steam"

echo ""
echo "Steam and its data have been removed."
