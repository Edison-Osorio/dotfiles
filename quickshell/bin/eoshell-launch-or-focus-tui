#!/bin/bash

# eoshell:summary=Launch a TUI or focus an existing terminal window for it
# eoshell:args=[--app-id=<app-id>] <command> [args...]

if [[ ${1:-} == --app-id=* ]]; then
  APP_ID="${1#--app-id=}"
else
  APP_ID="org.eoshell.$(basename "$1")"
fi

LAUNCH_COMMAND="eoshell-launch-tui $@"

exec eoshell-launch-or-focus "$APP_ID" "$LAUNCH_COMMAND"
