#!/bin/bash

# eoshell:summary=Install and configure Hex dictation
# eoshell:requires-sudo=true

set -e

eoshell-pkg-add hex-bin
# Download the speech model here, with progress, instead of silently on first launch.
hex model install
systemctl --user enable hex.service
# Launching through the CLI saves this session's display environment for the unit before starting it.
hex start
eoshell-dictation-use hex
eoshell-restart-hyprctl
eoshell-notification-send -g  "$(eoshell-i18n dictation.hexReady)" "$(eoshell-i18n dictation.hint)" -t 10000
