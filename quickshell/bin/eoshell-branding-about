#!/bin/bash

# eoshell:summary=Edit, set, or reset About branding
# eoshell:group=branding
# eoshell:name=about
# eoshell:args=<image|text|reset>
# eoshell:examples=eoshell branding about image | eoshell branding about text | eoshell branding about reset

set -euo pipefail

case "${1:-}" in
image)
  image=$(eoshell-file-select --title "$(eoshell-i18n branding.pickAboutImage)" --extensions "png svg")
  if eoshell-transcode-ascii "$image" ~/.config/eoshell/branding/about.txt --width 54 --height 26; then
    eoshell-launch-about >/dev/null 2>&1
  fi
  ;;
text)
  eoshell-launch-editor ~/.config/eoshell/branding/about.txt >/dev/null 2>&1 && eoshell-launch-about >/dev/null 2>&1
  ;;
reset)
  cp "$EOSHELL_PATH/icon.txt" ~/.config/eoshell/branding/about.txt && eoshell-launch-about >/dev/null 2>&1
  ;;
*)
  echo "Usage: eoshell-branding-about <image|text|reset>" >&2
  exit 1
  ;;
esac
