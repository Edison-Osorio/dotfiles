#!/bin/bash

# eoshell:summary=Show which theme is styling the Plymouth boot screen
# eoshell:examples=eoshell plymouth current

# eoshell-plymouth-set installs the theme's unlock.png as a byte-for-byte
# copy of logo.png, so matching it back identifies the current theme.
installed_logo=/usr/share/plymouth/themes/eoshell/logo.png

if cmp -s "$EOSHELL_PATH/default/plymouth/logo.png" "$installed_logo"; then
  echo default
  exit
fi

eoshell-plymouth-list | while read -r name; do
  if cmp -s "$(eoshell-theme-dir "$name")/unlock.png" "$installed_logo"; then
    echo "$name"
    exit
  fi
done
