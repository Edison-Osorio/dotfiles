#!/bin/bash

# eoshell:summary=Launch a floating terminal with the Eoshell presentation wrapper
# eoshell:args=<command>

# Export the current theme's gum styling so gum widgets match the active theme
# even after a theme switch (the inherited environment is captured at login).
source eoshell-restart-gum

cmd="$*"
# 130 is the user bailing with Ctrl-C; anything else gets the Done/Failed prompt.
presentation_script="eoshell-show-logo; $cmd; code=\$?; if (( code != 130 )); then eoshell-show-done \$code; fi"

exec setsid uwsm-app -- xdg-terminal-exec --app-id=org.eoshell.terminal --title=Eoshell -e bash -c "$presentation_script"
