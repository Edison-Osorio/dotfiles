#!/bin/bash

# eoshell:summary=Install and start the Dropbox service. Must then be authenticated via the web.
# eoshell:requires-sudo=true

echo "Installing all dependencies..."
eoshell-pkg-add dropbox dropbox-cli libappindicator python-gpgme nautilus-dropbox

echo "Adding Dropbox to the bar..."
eoshell-plugin-enable eoshell.dropbox

echo "Starting Dropbox..."
uwsm-app -- dropbox-cli start &>/dev/null &
echo "See Dropbox icon behind  hover tray in top right and right-click for setup."
