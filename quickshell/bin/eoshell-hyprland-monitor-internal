#!/bin/bash

# eoshell:summary=Enable, disable, toggle, or recover the internal laptop display
# eoshell:args=<on|off|toggle|recover>

TOGGLE="internal-monitor-disable"
TOGGLE_FLAG="$HOME/.local/state/eoshell/toggles/hypr/$TOGGLE.lua"
MIRROR_TOGGLE="internal-monitor-mirror"

INTERNAL=$(eoshell-hyprland-monitor-laptop)

wake() {
  hyprctl dispatch 'hl.dsp.dpms({ action = "enable" })' >/dev/null 2>&1 || true
}

on() {
  if eoshell-hyprland-toggle-enabled $TOGGLE; then
    eoshell-hyprland-toggle $TOGGLE off
    eoshell-notification-send -g 󰍹 "$(eoshell-i18n monitor.laptopEnabled)"
  fi

  wake
}

off() {
  if [[ -z $INTERNAL ]]; then
    eoshell-notification-send -g 󰍹 "$(eoshell-i18n monitor.noLaptopDisplay)"
    exit 1
  fi

  # The name is written into generated Lua below, so only a plain connector
  # name may pass; anything else could execute on the next reload.
  if [[ ! $INTERNAL =~ ^[A-Za-z0-9._-]+$ ]]; then
    eoshell-notification-send -g 󰍹 "$(eoshell-i18n monitor.unsafeName)"
    exit 1
  fi

  if ! eoshell-hyprland-monitor-external-active; then
    eoshell-notification-send -g 󰍹 "$(eoshell-i18n monitor.onlyDisplay)"
    exit 1
  fi

  if eoshell-hyprland-toggle-disabled $TOGGLE && eoshell-hyprland-toggle-disabled $MIRROR_TOGGLE; then
    printf 'hl.monitor({ output = "%s", disabled = true })\n' "$INTERNAL" >"$TOGGLE_FLAG"
    eoshell-notification-send -g 󰍹 "$(eoshell-i18n monitor.laptopDisabled)"
    eoshell-restart-hyprctl
  fi
}

recover() {
  # Runs from the clamshell watcher every few seconds, so it must be a no-op
  # unless it actually re-enables a display: an unconditional wake here undoes
  # lock-screen blanking and races the resume modeset into a visible flash.
  eoshell-hyprland-monitor-external-active && return 0
  eoshell-hyprland-toggle-enabled $TOGGLE || return 0

  eoshell-hyprland-toggle $TOGGLE off
  wake
}

toggle() {
  if eoshell-hyprland-toggle-enabled $TOGGLE; then
    on
  else
    off
  fi
}

case "$1" in
  on) on ;;
  off) off ;;
  toggle) toggle ;;
  recover) recover ;;
  *)
    echo "Usage: $(basename "$0") {on|off|toggle|recover}" >&2
    exit 1
    ;;
esac
