#!/bin/bash

# eoshell:summary=Print the active Eoshell dev-link git branch
# eoshell:hidden=true

eoshell_path=${EOSHELL_PATH:-/usr/share/eoshell}
eoshell_path=${eoshell_path%/}

[[ $eoshell_path != "/usr/share/eoshell" ]] || exit 1

branch=$(git -C "$eoshell_path" branch --show-current 2>/dev/null || true)
if [[ -z $branch ]]; then
  hash=$(git -C "$eoshell_path" rev-parse --short HEAD 2>/dev/null || true)
  [[ -n $hash ]] || exit 1
  branch="detached@$hash"
fi

echo "$branch"
