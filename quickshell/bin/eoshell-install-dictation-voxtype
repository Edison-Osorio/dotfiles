#!/bin/bash

# eoshell:summary=Install and configure Voxtype dictation
# eoshell:requires-sudo=true

set -e

voxtype_lib_path="${EOSHELL_VOXTYPE_LIB_PATH:-/usr/lib/voxtype}"

if eoshell-cmd-missing voxtype; then
  if gum confirm --affirmative "$(eoshell-i18n common.yes)" --negative "$(eoshell-i18n common.no)" "$(eoshell-i18n dictation.installVoxtype)"; then
    eoshell-pkg-add wtype voxtype-bin
  else
    exit 0
  fi
fi

config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
mkdir -p "$config_home/voxtype"
if [[ ! -e $config_home/voxtype/config.toml ]]; then
  cp "$EOSHELL_PATH/default/voxtype/config.toml" "$config_home/voxtype/"
  # A Vulkan runtime is not enough: aarch64 voxtype-bin ships no Vulkan backend.
  if eoshell-hw-vulkan && [[ -x $voxtype_lib_path/voxtype-vulkan ]]; then
    voxtype setup gpu --enable || true
  fi
fi

# Setup reuses the configured model and downloads it only when missing.
# Retry these steps even when an earlier attempt already installed the binary.
voxtype setup --download --no-post-install
voxtype setup systemd
systemctl --user enable --now voxtype.service

eoshell-dictation-use voxtype
eoshell-restart-hyprctl
eoshell-notification-send -g  "$(eoshell-i18n dictation.voxtypeReady)" "$(eoshell-i18n dictation.hint)" -t 10000
