#!/bin/bash

# eoshell:summary=Toggle animations, blur and shadows, which are slow without a GPU
# eoshell:args=[toggle|on|off]
# eoshell:examples=eoshell toggle animations | eoshell toggle animations off | eoshell toggle animations on

case ${1:-toggle} in
toggle)
  if eoshell-hyprland-animations-off; then
    animations=on
  else
    animations=off
  fi
  ;;
on | off) animations=$1 ;;
*)
  echo "Usage: eoshell-toggle-animations [toggle|on|off]" >&2
  exit 1
  ;;
esac

# A session that renders on the CPU turns animations off by itself
# (default/hypr/software-rendering.lua). Turning them on there is remembered for
# later sessions too, and has to be in place before the toggle reloads Hyprland.
without_gpu="$HOME/.local/state/eoshell/toggles/animations-without-gpu"

# The flag records animations being off, so on and off swap on the way through.
if [[ $animations == "on" ]]; then
  if [[ -e $XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/eoshell-software-rendering ]]; then
    mkdir -p "${without_gpu%/*}"
    touch "$without_gpu"
  fi
  eoshell-hyprland-toggle no-animations off
else
  rm -f "$without_gpu"
  eoshell-hyprland-toggle no-animations on
fi

if eoshell-hyprland-animations-off; then
  eoshell-notification-send -g 󰗘 "$(eoshell-i18n animations.disabled)"
else
  eoshell-notification-send -g 󰗘 "$(eoshell-i18n animations.enabled)"
fi
