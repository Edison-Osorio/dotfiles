#!/bin/bash

# eoshell:summary=Finish first-login setup for Eoshell.
# eoshell:args=[--force]
# eoshell:hidden=true

set -e

usage() {
  cat <<USAGE
Usage: eoshell-provision-first-run [--force]

Run first-login user setup and notification hooks. By default this only runs
once per user.
USAGE
}

force=0
finalize_user_args=()
while (($#)); do
  case "$1" in
    --force)
      force=1
      finalize_user_args+=(--force)
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

state_dir=~/.local/state/eoshell
FIRST_RUN_DONE="first-run-user"
if eoshell-done check "$FIRST_RUN_DONE" && (( force == 0 )); then
  echo "First-run already complete."
  exit 0
fi

eoshell-provision-user "${finalize_user_args[@]}" || true

mkdir -p "$state_dir"

FIRST_RUN_LOG="$state_dir/first-run.log"
first_run_failed=0

log_first_run() {
  printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >>"$FIRST_RUN_LOG"
}

run_first_run_step() {
  local name="$1"
  shift

  log_first_run "Starting: $name"
  if "$@"; then
    log_first_run "Completed: $name"
  else
    local status=$?
    first_run_failed=1
    log_first_run "Failed: $name (exit code: $status)"
  fi
}

run_first_run_step "enable user systemd units" \
  bash "$EOSHELL_PATH/install/user/first-run/enable-user-units.sh"
# Finalization ran it too, maybe without a session; the platform finishes what
# needs one here.
run_first_run_step "run the platform's user setup" \
  eoshell-lifecycle-dispatch setup-user
run_first_run_step "set GNOME theme" \
  bash "$EOSHELL_PATH/install/user/first-run/gnome-theme.sh"
run_first_run_step "set GTK primary paste" \
  bash "$EOSHELL_PATH/install/user/first-run/gtk-primary-paste.sh"
run_first_run_step "apply speaker tuning" \
  bash "$EOSHELL_PATH/install/user/first-run/audio-tuning.sh"

eoshell-notification-wait || log_first_run "Timed out waiting for notification service; continuing"
# Superwhisper places its bar panel through the shell, so it waits for it too.
run_first_run_step "configure Superwhisper dictation" \
  bash "$EOSHELL_PATH/install/user/first-run/superwhisper.sh"
# Each send returns only once the server has taken the toast, so sending in
# order is enough to stack them newest-on-top.
run_first_run_step "show welcome notification" \
  bash "$EOSHELL_PATH/install/user/first-run/welcome.sh"
run_first_run_step "show git setup notification" \
  bash "$EOSHELL_PATH/install/user/first-run/git.sh"
run_first_run_step "schedule Wi-Fi, agent, fingerprint and update notifications" \
  bash "$EOSHELL_PATH/install/user/first-run/wifi.sh"

if (( first_run_failed == 0 )); then
  eoshell-done mark "$FIRST_RUN_DONE"
else
  log_first_run "One or more first-run steps failed; first-run will retry next login"
fi
