#!/bin/bash

# eoshell:summary=Clear the shell update indicator after an update
# eoshell:hidden=true

# eoshell-update now clears the indicator itself. This stays for an update
# started by an older eoshell-update: its pipeline was parsed before the
# upgrade replaced it, and still calls this right after a full upgrade that
# went through, so there is nothing left for the indicator to show.
eoshell-shell -q eoshell.system-update clear
