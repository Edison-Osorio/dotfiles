#!/bin/bash

# eoshell:summary=Print the directory holding a theme, preferring a user-installed copy
# eoshell:args=<theme-name>
# eoshell:examples=eoshell theme dir tokyo-night

theme="${1:-}"

if [[ -z $theme ]]; then
  echo "Usage: eoshell-theme-dir <theme-name>" >&2
  exit 1
fi

if [[ -d $HOME/.config/eoshell/themes/$theme ]]; then
  echo "$HOME/.config/eoshell/themes/$theme"
else
  echo "$EOSHELL_PATH/themes/$theme"
fi
