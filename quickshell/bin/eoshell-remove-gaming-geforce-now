#!/bin/bash

# eoshell:summary=Remove the GeForce NOW Flatpak app and its data.
# eoshell:group=remove
# eoshell:name=gaming geforce-now

set -e

if eoshell-cmd-present flatpak && flatpak info com.nvidia.geforcenow &>/dev/null; then
  flatpak uninstall -y --delete-data com.nvidia.geforcenow
fi

echo ""
echo "GeForce NOW removed."
