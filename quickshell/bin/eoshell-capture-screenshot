#!/bin/bash

# eoshell:summary=Take a screenshot
# eoshell:group=capture
# eoshell:args=[smart|region|windows|fullscreen|scroll] [copy|save]
# eoshell:examples=eoshell screenshot | eoshell capture screenshot region
# eoshell:aliases=eoshell screenshot

if [[ -n ${EOSHELL_SCREENSHOT_DIR:-} && -z ${OMASNAP_SCREENSHOT_DIR:-} ]]; then
  export OMASNAP_SCREENSHOT_DIR="$EOSHELL_SCREENSHOT_DIR"
fi

# --notify announces saved shots with Open and Edit buttons instead of a
# preview. Omasnap reads that toast's text from this catalog itself:
#   eoshell-i18n capture.screenshotSaved, eoshell-i18n capture.screenshotSavedCopied,
#   eoshell-i18n capture.screenshotOpen, eoshell-i18n capture.screenshotEdit
omasnap_args=(--notify)
for arg in "$@"; do
  case "$arg" in
    copy) omasnap_args+=(--copy) ;;
    save) omasnap_args+=(--save) ;;
    slurp) ;;
    *) omasnap_args+=("$arg") ;;
  esac
done

exec omasnap "${omasnap_args[@]}"
