#!/bin/bash

# eoshell:summary=Reinstall all default Eoshell packages from the stable channel, or on Apple Silicon the edge channel
# eoshell:requires-sudo=true

set -e

# Reinstall all default Eoshell packages from the platform's default channel
# (stable, or edge on Apple Silicon) and downgrade any packages that are too new.

# Set the package repository to the platform's default channel
source "$EOSHELL_PATH/install/helpers/pacman.sh"
platform=$(eoshell-hw-platform)
channel=$(eoshell_pacman_default_channel "$platform")
eoshell-refresh-pacman "$channel"

# Downgrade any packages to that channel's setup
eoshell-update-pacman -Suu --noconfirm

# Ensure this platform's default packages are installed
default_packages=$(eoshell-pkg-defaults)
mapfile -t packages <<<"$default_packages"
# --ask 4 accepts removing a stock package a default replaces, such as
# power-profiles-daemon for eoshell-power-profiles-daemon.
eoshell-update-pacman -Syu --noconfirm --ask 4 --needed "${packages[@]}"
