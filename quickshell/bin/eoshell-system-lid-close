#!/bin/bash

# eoshell:summary=Lock and reconcile displays when the laptop lid closes
# eoshell:group=system
# eoshell:hidden=true

# Locking here rather than waiting for PrepareForSleep is what keeps the lock
# off the critical path. logind's delay inhibitor is a timer that expires
# whether or not the session is secure, so starting the lock the moment the lid
# closes gives Quickshell a head start before logind even decides to suspend.
# eoshell-system-sleep-lock then usually finds the session already secure.
#
# A docked lid close does not suspend (HandleLidSwitchDocked defaults to
# ignore, and eoshell-system-lid-inhibit covers displays logind does not count),
# so it must not lock either: that is clamshell mode, still in use on the
# external display.
if eoshell-hw-laptop-closed && ! eoshell-hw-external-monitors; then
  eoshell-system-lock >/dev/null 2>&1 || true
fi

eoshell-hyprland-monitor-clamshell
