#!/bin/bash

# eoshell:summary=Record dictation with the configured backend
# eoshell:args=<start|stop|toggle>
# eoshell:examples=eoshell dictation start | eoshell dictation toggle

if (($# != 1)) || [[ $1 != "start" && $1 != "stop" && $1 != "toggle" ]]; then
  echo "Usage: eoshell dictation <start|stop|toggle>" >&2
  exit 1
fi

config="${XDG_CONFIG_HOME:-$HOME/.config}/eoshell/defaults/dictation"
mkdir -p "${config%/*}"
exec 9> "$config.lock"
if ! flock -w 5 9; then
  echo "Dictation is busy; try again." >&2
  exit 1
fi

backend=$(eoshell-default-dictation) || exit 1
adapter="eoshell-dictation-$backend"
if eoshell-cmd-missing "$adapter"; then
  echo "The selected dictation backend ($backend) is not installed." >&2
  exit 1
fi
"$adapter" "$1" 9>&-
