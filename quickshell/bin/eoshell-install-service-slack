#!/bin/bash

# eoshell:summary=Install Slack Desktop with live Eoshell theme support
# eoshell:requires-sudo=true

set -euo pipefail

eoshell-pkg-add slack-desktop
if eoshell-setup-slack; then
  setsid eoshell-app -- gtk-launch slack >/dev/null 2>&1 &
else
  echo "Slack theme setup failed; opening packaged Slack." >&2
  setsid eoshell-app -- gio launch /usr/share/applications/slack.desktop >/dev/null 2>&1 &
fi
