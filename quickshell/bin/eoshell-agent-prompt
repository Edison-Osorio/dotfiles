#!/bin/bash

# eoshell:summary=Launch the default coding agent with a prompt
# eoshell:args=[--inline] <prompt...>
# eoshell:examples=eoshell agent prompt "Review this project"

# Prompts live here rather than on `eoshell agent`, where a bare prompt would
# shadow the subcommands under that group.

set -euo pipefail

inline=()
if [[ ${1:-} == "--inline" ]]; then
  inline=(--inline)
  shift
fi

if (($# == 0)); then
  echo "Usage: eoshell agent prompt [--inline] <prompt...>" >&2
  exit 1
fi

exec eoshell-agent "${inline[@]}" --prompt "$*"
