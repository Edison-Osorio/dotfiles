{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "background": "opaque",
    "layout": {
      "left": [
        {
          "id": "eoshell.menu"
        },
        {
          "id": "eoshell.workspaces"
        }
      ],
      "centerBegin": [
        {
          "id": "eoshell.indicators"
        }
      ],
      "center": [
        {
          "id": "eoshell.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n\u2014\nmm"
        }
      ],
      "centerEnd": [
        {
          "id": "eoshell.elsewhen"
        },
        {
          "id": "eoshell.weather"
        },
        {
          "id": "eoshell.system-update"
        }
      ],
      "right": [
        {
          "id": "eoshell.tray"
        },
        {
          "id": "eoshell.keyboard-layout"
        },
        {
          "id": "eoshell.agents"
        },
        {
          "id": "eoshell.bluetooth"
        },
        {
          "id": "eoshell.network"
        },
        {
          "id": "eoshell.audio"
        },
        {
          "id": "eoshell.monitor"
        },
        {
          "id": "eoshell.power"
        }
      ]
    }
  },
  "dock": {
    "position": "bottom",
    "pinned": [
      "org.gnome.Nautilus",
      "chromium",
      "foot",
      "omacalc",
      "omawrite",
      "X",
      "YouTube"
    ]
  },
  "plugins": []
}
