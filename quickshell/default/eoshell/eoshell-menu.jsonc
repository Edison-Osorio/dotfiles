{
  // Menú de eoshell (Super+Espacio en la referencia; aquí se abre por IPC).
  // Menú corto para Fedora: solo entradas que usan mis scripts (~/.local/bin) o herramientas de Fedora.
  // JSONC: JSON con comentarios de línea completa y comas finales. Los ids con punto forman el árbol:
  // "trigger.capture.region" cuelga de "trigger.capture". Tipo inferido: action -> acción,
  // target -> enlace, nada -> submenú. Campos opcionales: when, checked, title, provider, iconFont.
  // Detalles en docs/menu.md.

  // Raíz
  "apps": {"icon":"","label":"Apps","aliases":["app","applications"],"provider":"apps","action":"eoshell-shell eoshell.dock apps"},
  "appearance": {"icon":"","label":"Appearance","aliases":["style"]},
  "trigger": {"icon":"","label":"Trigger"},
  "setup": {"icon":"","label":"Setup","aliases":["settings"]},
  "install": {"icon":"","label":"Install"},
  "remove": {"icon":"","label":"Remove","aliases":["uninstall"],"action":"$HOME/.local/bin/pkg-menu remove"},
  "update": {"icon":"","label":"Update","aliases":["refresh"],"action":"$HOME/.local/bin/pkg-menu update"},
  "learn": {"icon":"","label":"Learn"},
  "system": {"icon":"","label":"System","aliases":["power-menu"]},

  // Appearance
  "appearance.bar": {"icon":"","label":"Bar"},
  "appearance.bar.background": {"icon":"","label":"Bar Background"},
  "appearance.bar.background.opaque": {"label":"Opaque Bar","checked":"[[ $(eoshell-bar background) == \"opaque\" ]]","action":"eoshell-bar background opaque"},
  "appearance.bar.background.glassy": {"label":"Glassy Bar","checked":"[[ $(eoshell-bar background) == \"glassy\" ]]","action":"eoshell-bar background glassy"},
  "appearance.bar.background.clear": {"label":"Clear Bar","checked":"[[ $(eoshell-bar background) == \"none\" ]]","action":"eoshell-bar background none"},
  "appearance.bar.position": {"icon":"","label":"Bar Position"},
  "appearance.bar.position.top": {"label":"Top Bar","checked":"[[ $(eoshell-bar position) == \"top\" ]]","action":"eoshell-bar position top"},
  "appearance.bar.position.bottom": {"label":"Bottom Bar","checked":"[[ $(eoshell-bar position) == \"bottom\" ]]","action":"eoshell-bar position bottom"},

  // Trigger
  "trigger.capture": {"icon":"","label":"Capture"},
  "trigger.capture.region": {"label":"Screenshot (region)","action":"$HOME/.local/bin/screenshot region"},
  "trigger.capture.window": {"label":"Screenshot (window)","action":"$HOME/.local/bin/screenshot window"},
  "trigger.capture.screen": {"label":"Screenshot (screen)","action":"$HOME/.local/bin/screenshot screen"},
  "trigger.color": {"icon":"","label":"Color Picker","action":"pkill hyprpicker || hyprpicker -a"},
  "trigger.clipboard": {"icon":"","label":"Clipboard History","action":"$HOME/.local/bin/clipboard-menu"},
  "trigger.emoji": {"icon":"","label":"Emoji","action":"eoshell-menu-emoji"},
  "trigger.nightlight": {"icon":"","label":"Nightlight","action":"eoshell-toggle-nightlight"},

  // Setup
  "setup.wifi": {"icon":"","label":"Wi-Fi","action":"$HOME/.local/bin/launch-tui wifi"},
  "setup.bluetooth": {"icon":"","label":"Bluetooth","action":"$HOME/.local/bin/launch-tui bluetooth"},
  "setup.audio": {"icon":"","label":"Audio","action":"$HOME/.local/bin/launch-tui audio"},
  "setup.display": {"icon":"","label":"Display","action":"$HOME/.local/bin/monitor-layout"},
  "setup.idle": {"icon":"","label":"Idle & Sleep","action":"$HOME/.local/bin/idle-settings"},

  // Install
  "install.package": {"icon":"","label":"Package (dnf)","action":"$HOME/.local/bin/pkg-menu install"},
  "install.flatpak": {"icon":"","label":"Flatpak","action":"$HOME/.local/bin/pkg-menu flatpak"},

  // Learn
  "learn.hyprland": {"label":"Hyprland","action":"xdg-open https://wiki.hypr.land/"},
  "learn.quickshell": {"label":"Quickshell","action":"xdg-open https://quickshell.org/docs/"},
  "learn.fedora": {"label":"Fedora","action":"xdg-open https://docs.fedoraproject.org/"},

  // System
  "system.lock": {"icon":"","label":"Lock","action":"pidof hyprlock >/dev/null || hyprlock"},
  "system.suspend": {"icon":"","label":"Suspend","action":"systemctl suspend"},
  "system.session": {"icon":"","label":"Log out / Restart / Power off…","action":"$HOME/.local/bin/power-menu"},
}
