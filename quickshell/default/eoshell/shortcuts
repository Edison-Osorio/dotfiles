# Hyprland global shortcuts the Eoshell shell registers, one per line: a menu
# route to toggle, a panel plugin to toggle, a volume or brightness key, or an
# argument-free IPC call as target.method. A binding written as o.bind(keys,
# description, { menu = "theme" }), { panel = "eoshell.emojis" },
# { audio = "raise" }, { brightness = "raise" } or { ipc = "media.next" }
# dispatches the matching shortcut straight to the shell, with no process to
# spawn per keypress. Anything missing here still binds, through the
# eoshell-menu, eoshell-shell, eoshell-audio-output-volume or
# eoshell-brightness-display command instead.
menu root
menu apps
menu capture
menu toggle
menu hardware
menu system
menu background
menu theme
menu share
menu reminder-set
panel eoshell.clipboard
panel eoshell.emojis
panel eoshell.audio
panel eoshell.bluetooth
panel eoshell.monitor
panel eoshell.clock
panel eoshell.elsewhen
panel eoshell.network
panel eoshell.power
audio raise
audio lower
audio mute-toggle
brightness raise
brightness lower
ipc media.playPause
ipc media.next
ipc media.previous
ipc notifications.act
ipc notifications.dismissOne
ipc notifications.dismissAll
ipc notifications.invokeLast
ipc notifications.showHistory
