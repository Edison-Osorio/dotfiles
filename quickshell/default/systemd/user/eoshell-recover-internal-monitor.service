[Unit]
Description=Recover the internal monitor toggle when no external display is connected
Before=graphical-session-pre.target
ConditionPathExists=%h/.local/state/eoshell/toggles/hypr/internal-monitor-disable.lua

[Service]
Type=oneshot
ExecStart=/usr/bin/eoshell-hw-recover-internal-monitor

[Install]
WantedBy=graphical-session-pre.target
