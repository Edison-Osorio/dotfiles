: "${EOSHELL_PATH:=/usr/share/eoshell}"
source "$EOSHELL_PATH/default/bash/envs"
source "$EOSHELL_PATH/default/bash/shell"
source "$EOSHELL_PATH/default/bash/aliases"
source "$EOSHELL_PATH/default/bash/functions"
source "$EOSHELL_PATH/default/bash/init"
[[ $- == *i* ]] && bind -f "$EOSHELL_PATH/default/bash/inputrc"
