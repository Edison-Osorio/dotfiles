# Single source of truth for EOSHELL_PATH + PATH adjustments. Sourced by:
#   /etc/profile.d/eoshell.sh                 (system login shells)
#   /etc/skel/.bashrc                         (interactive shells)
#   /usr/share/uwsm/env.d/10-eoshell          (Hyprland session via uwsm)
#   /usr/share/eoshell/default/bash/envs      (bash rc chain; SSH/non-login)

# /etc/eoshell.conf is written by eoshell-dev-link and reset by
# eoshell-dev-unlink. When absent, force the packaged default instead of
# preserving a stale inherited value.
if [ -f /etc/eoshell.conf ]; then
  . /etc/eoshell.conf
  : "${EOSHELL_PATH:=/usr/share/eoshell}"
else
  EOSHELL_PATH=/usr/share/eoshell
fi
export EOSHELL_PATH

# Only prepend in dev-link mode. On a production install, the binaries are
# already on PATH as /usr/bin/eoshell-* via the eoshell package — prepending
# /usr/share/eoshell/bin would just be noise.
if [ "$EOSHELL_PATH" != /usr/share/eoshell ]; then
  case ":$PATH:" in
    *":${EOSHELL_PATH%/}/bin:"*) ;;
    *) PATH="${EOSHELL_PATH%/}/bin${PATH:+:$PATH}" ;;
  esac
fi

# mise's command wrappers must precede real tool directories inherited from a
# parent shell, so scripts follow account switches without Bash functions.
# mise activate also keeps this directory ahead of its managed tool binaries.
eoshell_wrapper_dir="${MISE_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/mise}/command-wrappers/bin"
eoshell_wrapper_path=$eoshell_wrapper_dir
if [ -n "${PATH:-}" ]; then
  eoshell_remaining_path=$PATH
  while :; do
    eoshell_path_entry=${eoshell_remaining_path%%:*}
    if [ "$eoshell_path_entry" != "$eoshell_wrapper_dir" ]; then
      eoshell_wrapper_path="$eoshell_wrapper_path:$eoshell_path_entry"
    fi
    case "$eoshell_remaining_path" in
      *:*) eoshell_remaining_path=${eoshell_remaining_path#*:} ;;
      *) break ;;
    esac
  done
fi
PATH=$eoshell_wrapper_path
unset eoshell_wrapper_dir eoshell_wrapper_path eoshell_remaining_path eoshell_path_entry

# User-level tool paths, appended so system binaries keep precedence. This is
# what lets login shells (ssh, bash -lc) and the uwsm session find mise-managed
# tools without an interactive rc. Keep these directories in sync with the PAM
# PATH line from install/config/ssh-command-path.sh, which covers SSH commands
# that run no shell setup at all.
case ":$PATH:" in
  *":$HOME/.local/share/mise/shims:"*) ;;
  *) PATH="${PATH:+$PATH:}$HOME/.local/share/mise/shims" ;;
esac
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) PATH="${PATH:+$PATH:}$HOME/.local/bin" ;;
esac
export PATH
