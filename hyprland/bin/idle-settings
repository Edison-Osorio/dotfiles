#!/usr/bin/env python3
"""Menú para ajustar cuándo se bloquea, apaga la pantalla y suspende. Reescribe hypridle.conf."""
import os, re, subprocess

CONF = os.path.realpath(os.path.expanduser("~/.config/hypr/hypridle.conf"))
CHOICES = {"1 min": 60, "2 min": 120, "5 min": 300, "10 min": 600, "15 min": 900,
           "30 min": 1800, "1 hora": 3600, "Nunca": 0}

def rofi(prompt, options):
    out = subprocess.run(["rofi", "-dmenu", "-i", "-p", prompt, "-no-custom", "-theme-str", "window {width: 380px;}"],
                         input="\n".join(options), capture_output=True, text=True).stdout.strip()
    return out or None

def fmt(s):
    return "Nunca" if s == 0 else next((k for k, v in CHOICES.items() if v == s), f"{s}s")

text = open(CONF).read()
cur = {k: int(re.search(rf"# {k}=(\d+)", text).group(1)) for k in ("lock", "suspend")}

what = rofi("Ajustes de inactividad", [f"󰌾  Bloquear pantalla ({fmt(cur['lock'])})",
                                      f"󰤄  Suspender equipo ({fmt(cur['suspend'])})"])
if not what:
    raise SystemExit
key = "lock" if "Bloquear" in what else "suspend"
val = rofi("Tras" if key == "lock" else "Suspender tras", list(CHOICES))
if not val:
    raise SystemExit
cur[key] = CHOICES[val]

lock, susp = cur["lock"], cur["suspend"]
parts = ["""# lock=%d
# suspend=%d
general {
    lock_cmd = pidof hyprlock || hyprlock
    before_sleep_cmd = loginctl lock-session
    after_sleep_cmd = hyprctl dispatch 'hl.dsp.dpms({ action = "on" })'
}
""" % (lock, susp)]
if lock:
    parts.append(f"""
listener {{
    timeout = {lock}
    on-timeout = loginctl lock-session
}}

listener {{
    timeout = {lock + 30}
    on-timeout = hyprctl dispatch 'hl.dsp.dpms({{ action = "off" }})'
    on-resume = hyprctl dispatch 'hl.dsp.dpms({{ action = "on" }})'
}}
""")
if susp:
    parts.append(f"""
listener {{
    timeout = {susp}
    on-timeout = systemctl suspend
}}
""")
open(CONF, "w").write("".join(parts))
subprocess.run(["pkill", "-x", "hypridle"])
subprocess.Popen(["hypridle"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
subprocess.run(["notify-send", "Inactividad", f"Bloqueo: {fmt(lock)} · Suspensión: {fmt(susp)}"])
