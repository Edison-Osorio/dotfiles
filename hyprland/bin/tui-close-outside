#!/usr/bin/env python3
"""Cierra los menús flotantes (tui-float y rofi) si el clic cae fuera de ellos."""
import json, os, subprocess

def hypr(*a):
    return json.loads(subprocess.run(["hyprctl", *a, "-j"], capture_output=True, text=True).stdout or "[]")

cur = hypr("cursorpos")
for w in hypr("clients"):
    if w["class"] != "tui-float":
        continue
    (x, y), (ww, hh) = w["at"], w["size"]
    if not (x <= cur["x"] <= x + ww and y <= cur["y"] <= y + hh):
        try:
            os.kill(w["pid"], 15)
        except ProcessLookupError:
            pass

for mon in hypr("layers").values():
    for level in mon["levels"].values():
        for l in level:
            if l["namespace"] != "rofi":
                continue
            if not (l["x"] <= cur["x"] <= l["x"] + l["w"] and l["y"] <= cur["y"] <= l["y"] + l["h"]):
                try:
                    os.kill(l["pid"], 15)
                except ProcessLookupError:
                    pass
