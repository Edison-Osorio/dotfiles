#!/bin/sh
# Prueba el shell de Omarchy (Quickshell) junto a tu Waybar, sin reemplazarlo.
# Uso: omarchy-shell-test [start|stop|toggle|status|log]
# Requiere la copia en ~/.local/share/omarchy-test (con la línea OmarchyLoadPatch quitada).
OM="$HOME/.local/share/omarchy-test"
LOG="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-shell-test.log"
PAT="quickshell -p shell/shell.qml"

running() { pgrep -f "$PAT" >/dev/null; }

start() {
  running && { echo "ya está corriendo"; return; }
  [ -f "$OM/shell/shell.qml" ] || { echo "falta $OM" >&2; exit 1; }
  cd "$OM" || exit 1
  OMARCHY_PATH="$OM" PATH="$OM/bin:$PATH" nohup $PAT >"$LOG" 2>&1 &
  echo "iniciado (log: $LOG)"
}
stop() { pkill -f "$PAT" && echo "detenido" || echo "no estaba corriendo"; }

case "${1:-toggle}" in
  start)  start ;;
  stop)   stop ;;
  toggle) if running; then stop; else start; fi ;;
  status) running && echo "corriendo" || echo "detenido" ;;
  log)    sed 's/\x1b\[[0-9;]*m//g' "$LOG" | grep -v desktopentry ;;
  *)      echo "Uso: omarchy-shell-test [start|stop|toggle|status|log]" >&2; exit 1 ;;
esac
