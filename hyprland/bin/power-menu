#!/usr/bin/env bash
# Menú de energía (SUPER + ESC), estilo Omarchy.
set -u

menu() { # menu <líneas> <items...>
  local lines="$1"; shift
  printf '%s\n' "$@" | rofi -dmenu -i -no-custom -p "" \
    -theme-str "window { width: 320px; } listview { lines: $lines; } inputbar { enabled: false; }"
}

choice=$(menu 5 "󰌾  Lock" "󰤄  Suspend" "󰍃  Log out" "󰜉  Restart" "󰐥  Power off") || exit 0

confirm() { [ "$(menu 2 "  Yes, $1" "  Cancel")" = "  Yes, $1" ]; }

case "$choice" in
  *Lock)       pidof hyprlock >/dev/null || hyprlock ;;
  *Suspend)      systemctl suspend ;;
  *"Log out") confirm "log out" && loginctl terminate-session "${XDG_SESSION_ID:-self}" ;;
  *Restart)      confirm "restart" && systemctl reboot ;;
  *"Power off")        confirm "power off" && systemctl poweroff ;;
esac
