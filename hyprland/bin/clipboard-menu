#!/usr/bin/env python3
"""Historial del portapapeles (cliphist) en rofi, con miniatura para las imágenes."""
import os, re, subprocess

cache = os.path.expanduser("~/.cache/cliphist-thumbs")
os.makedirs(cache, exist_ok=True)

lines = subprocess.run(["cliphist", "list"], capture_output=True, text=True).stdout.splitlines()
rows = []
for line in lines:
    id_, _, text = line.partition("\t")
    m = re.match(r"\[\[ binary data (.+?) (png|jpg|jpeg|bmp|gif) (\d+x\d+) \]\]", text)
    if m:
        thumb = f"{cache}/{id_}.png"
        if not os.path.exists(thumb):
            raw = subprocess.run(["cliphist", "decode", id_], capture_output=True).stdout
            subprocess.run(["magick", "-", "-thumbnail", "256x256>", thumb], input=raw, capture_output=True)
        rows.append(f"󰋩  Image {m.group(3)} · {m.group(1)}\0icon\x1f{thumb}")
    else:
        rows.append(text.replace("\n", " ")[:120])

if not rows:
    raise SystemExit
idx = subprocess.run(
    ["rofi", "-dmenu", "-i", "-p", "Clipboard", "-format", "i", "-no-custom",
     "-theme-str", "element-icon {size: 64px;} window {width: 640px;}"],
    input="\n".join(rows), capture_output=True, text=True,
).stdout.strip()
if idx:
    raw = subprocess.run(["cliphist", "decode"], input=lines[int(idx)].encode(), capture_output=True).stdout
    subprocess.run(["wl-copy"], input=raw)
