configuration {
  modi: "drun,run";
  show-icons: true;
  font: "JetBrainsMono Nerd Font 12";
  display-drun: "";
  drun-display-format: "{name}";
}

* {
  base: #24273a;
  surface0: #363a4f;
  text: #cad3f5;
  accent: #b7bdf8;
  red: #ed8796;
  green: #a6da95;
  background-color: transparent;
  text-color: @text;
}

window {
  width: 520px;
  background-color: @base;
  border: 2px;
  border-color: @accent;
  border-radius: 12px;
}
mainbox { padding: 12px; spacing: 8px; }
inputbar { padding: 8px 12px; background-color: @surface0; border-radius: 8px; spacing: 8px; }
entry { placeholder: "Search..."; placeholder-color: #6e738d; }
prompt { text-color: @accent; }
listview { lines: 8; spacing: 4px; scrollbar: false; }
element { padding: 8px 12px; border-radius: 8px; spacing: 10px; background-color: transparent; text-color: @text; }
element normal.normal, element alternate.normal { background-color: transparent; text-color: @text; }
element normal.urgent, element alternate.urgent { background-color: transparent; text-color: @red; }
element normal.active, element alternate.active { background-color: transparent; text-color: @green; }
element selected.normal { background-color: @accent; text-color: @base; }
element selected.urgent { background-color: @red; text-color: @base; }
element selected.active { background-color: @green; text-color: @base; }
element-icon { size: 24px; background-color: transparent; }
element-text { background-color: transparent; text-color: inherit; vertical-align: 0.5; }
